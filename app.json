{
  "expo": {
    "name": "Liner",
    "slug": "liner-android",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.liner.app",
      "deploymentTarget": "15.0",
      "infoPlist": {
        "NSAppleMusicUsageDescription": "Liner needs access to your media library to play local tracks.",
        "NSMicrophoneUsageDescription": "Liner needs microphone access for voice search.",
        "NSBluetoothAlwaysUsageDescription": "Liner uses Bluetooth to connect to audio devices.",
        "NSBluetoothPeripheralUsageDescription": "Liner uses Bluetooth to connect to audio devices.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "package": "com.liner.app",
      "permissions": [
        "android.permission.INTERNET",
        "android.permission.ACCESS_NETWORK_STATE",
        "android.permission.WAKE_LOCK",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-notifications",
      "expo-secure-store",
      "expo-av",
      "expo-file-system",
      "expo-image-picker"
    ],
    "extra": {
      "apiBaseUrl": "https://api.tryliner.fun",
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "49852943-758a-4bc8-a393-833431d61615"
      }
    },
    "owner": "d-corps"
  }
}
